{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "AgentRedirectServerUrl": "",
  "SmtpSettings": {
    "Server": "mail.cleverdata.gr",
    "Port": 587,
    "Username": "support@cleverdata.gr",
    "Password": "your-password-here",
    "EnableSsl": true,
    "Sender": "support@cleverdata.gr"
  }
}
