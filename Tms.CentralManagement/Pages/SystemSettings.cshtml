@page
@model Tms.CentralManagement.Pages.SystemSettingsModel
@{
    ViewData["Title"] = "Ρυθμίσεις Συστήματος";
}

<header>
    <div>
        <h1>⚙️ Ρυθμίσεις Συστήματος</h1>
        <p style="color: var(--text-secondary); font-size: 14px; margin-top: 4px;">
            Διαχειριστείτε τις γενικές ρυθμίσεις συστήματος και τις παραμέτρους επικοινωνίας των Agents.
        </p>
    </div>
</header>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div style="background-color: rgba(16, 185, 129, 0.15); border: 1.5px solid var(--success); color: var(--success); padding: 12px 15px; border-radius: 8px; margin-bottom: 20px; font-size: 14px;">
        ✅ @Model.SuccessMessage
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div style="background-color: rgba(239, 68, 68, 0.15); border: 1.5px solid var(--danger); color: var(--danger); padding: 12px 15px; border-radius: 8px; margin-bottom: 20px; font-size: 14px;">
        ❌ @Model.ErrorMessage
    </div>
}

<div style="max-width: 700px;">
    <!-- Τρέχουσα Κατάσταση -->
    <div class="card" style="padding: 20px; margin-bottom: 25px; display: flex; flex-direction: column; gap: 12px;">
        <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
            <span style="font-weight: 600; font-size: 14px; color: var(--text-secondary);">Ενεργό URL (Παραγωγικό):</span>
            <div>
                @if (Model.ActiveRedirect != null && !string.IsNullOrEmpty(Model.ActiveRedirect.AgentRedirectServerUrl))
                {
                    <span class="badge badge-success">ΕΝΕΡΓΗ ΑΝΑΚΑΤΕΥΘΥΝΣΗ</span>
                    <strong style="margin-left: 8px; color: var(--success); font-family: monospace; font-size: 14px;">@Model.ActiveRedirect.AgentRedirectServerUrl</strong>
                }
                else
                {
                    <span class="badge badge-secondary">ΑΝΕΝΕΡΓΗ</span>
                    <span style="margin-left: 8px; color: var(--text-secondary); font-size: 13px;">(Σύνδεση απευθείας)</span>
                }
            </div>
        </div>
        <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
            <span style="font-weight: 600; font-size: 14px; color: var(--text-secondary);">Ενεργό URL (Δοκιμαστικό):</span>
            <div>
                @if (Model.ActiveRedirect != null && !string.IsNullOrEmpty(Model.ActiveRedirect.AgentRedirectTestServerUrl))
                {
                    <span class="badge badge-warning">ΕΝΕΡΓΗ ΑΝΑΚΑΤΕΥΘΥΝΣΗ</span>
                    <strong style="margin-left: 8px; color: var(--warning); font-family: monospace; font-size: 14px;">@Model.ActiveRedirect.AgentRedirectTestServerUrl</strong>
                }
                else
                {
                    <span class="badge badge-secondary">ΑΝΕΝΕΡΓΗ</span>
                    <span style="margin-left: 8px; color: var(--text-secondary); font-size: 13px;">(Σύνδεση απευθείας)</span>
                }
            </div>
        </div>
        <div style="display: flex; align-items: center; justify-content: space-between;">
            <span style="font-weight: 600; font-size: 14px; color: var(--text-secondary);">Τρέχον URL αυτού του Διακομιστή:</span>
            <strong style="color: var(--accent); font-family: monospace; font-size: 14px;">@(Request.Scheme)://@(Request.Host)</strong>
        </div>
    </div>

    <!-- Φόρμα Ρύθμισης -->
    <div class="card" style="padding: 25px; margin-bottom: 25px;">
        <div class="card-title" style="margin-bottom: 20px;">
            <span>Ρυθμίσεις Επικοινωνίας & Redirection</span>
        </div>

        <form method="post">
            <div class="form-group" style="margin-bottom: 20px;">
                <label style="font-weight: bold;">Διεύθυνση Ανακατεύθυνσης Agents (Παραγωγικό Περιβάλλον / Prod URL)</label>
                <input type="url" asp-for="AgentRedirectServerUrl" class="form-control" placeholder="π.χ. https://tmsagent.cdgr.dev" />
                <p style="color: var(--text-secondary); font-size: 12px; margin-top: 6px; line-height: 1.5;">
                    💡 <strong>Πώς λειτουργεί:</strong> Διεύθυνση ανακατεύθυνσης για τους Agents που λειτουργούν σε <strong>Παραγωγικό</strong> (Production) περιβάλλον. Αφήστε κενό για απενεργοποίηση της ανακατεύθυνσης.
                </p>
            </div>

            <div class="form-group" style="margin-bottom: 20px;">
                <label style="font-weight: bold;">Διεύθυνση Ανακατεύθυνσης Agents (Δοκιμαστικό Περιβάλλον / Test URL)</label>
                <input type="url" asp-for="AgentRedirectTestServerUrl" class="form-control" placeholder="π.χ. http://home.dhsweb.gr:5007" />
                <p style="color: var(--text-secondary); font-size: 12px; margin-top: 6px; line-height: 1.5;">
                    💡 <strong>Πώς λειτουργεί:</strong> Διεύθυνση ανακατεύθυνσης για τους Agents που λειτουργούν σε <strong>Δοκιμαστικό</strong> (Test) περιβάλλον. Αφήστε κενό για απενεργοποίηση της ανακατεύθυνσης.
                </p>
            </div>

            <div style="display: flex; gap: 15px; justify-content: flex-end; margin-top: 25px;">
                <a href="/Index" class="btn btn-outline" style="text-decoration: none; display: inline-flex; align-items: center; justify-content: center;">Ακύρωση</a>
                <button type="submit" class="btn">💾 Αποθήκευση Ρυθμίσεων</button>
            </div>
        </form>
    </div>

    <!-- Ιστορικό Καταχωρήσεων -->
    <div class="card" style="padding: 25px;">
        <div class="card-title" style="margin-bottom: 15px;">
            <span>⏳ Ιστορικό Αλλαγών & Καταγραφών</span>
        </div>
        
        @if (Model.History.Any())
        {
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr>
                            <th style="width: 25%;">Ημερομηνία / Ώρα</th>
                            <th style="width: 30%;">Παραγωγικό URL</th>
                            <th style="width: 30%;">Δοκιμαστικό URL</th>
                            <th style="width: 15%;">Χρήστης</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.History.Count; i++)
                        {
                            var item = Model.History[i];
                            <tr>
                                <td style="color: var(--text-secondary);">
                                    @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                                    @if (i == 0)
                                    {
                                        <span class="badge badge-info" style="font-size: 9px; padding: 1px 4px; margin-left: 4px;">Active</span>
                                    }
                                </td>
                                <td style="font-family: monospace; font-size: 13px;">
                                    @if (!string.IsNullOrEmpty(item.AgentRedirectServerUrl))
                                    {
                                        @item.AgentRedirectServerUrl
                                    }
                                    else
                                    {
                                        <span style="color: var(--text-secondary); font-style: italic; font-size: 12px;">[Κενό - Απενεργοποίηση]</span>
                                    }
                                </td>
                                <td style="font-family: monospace; font-size: 13px;">
                                    @if (!string.IsNullOrEmpty(item.AgentRedirectTestServerUrl))
                                    {
                                        @item.AgentRedirectTestServerUrl
                                    }
                                    else
                                    {
                                        <span style="color: var(--text-secondary); font-style: italic; font-size: 12px;">[Κενό - Απενεργοποίηση]</span>
                                    }
                                </td>
                                <td>
                                    <span style="color: var(--text-secondary);">@item.ChangedBy</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p style="color: var(--text-secondary); font-size: 14px; font-style: italic; text-align: center; padding: 15px 0;">
                Δεν υπάρχουν καταγεγραμμένες αλλαγές ιστορικού.
            </p>
        }
    </div>
</div>
